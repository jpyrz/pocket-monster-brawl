    "@types/node": "^24.13.3",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.9",
    "oxlint": "^1.81.0",
    "tsdown": "^0.21.4",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.0"
