{
  "name": "pocket-monster-brawl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n parser,api,web -c yellow,magenta,cyan \"npm run dev:parser\" \"npm run dev -w @pmb/server\" \"npm run dev -w @pmb/web\"",
    "dev:api": "npm run dev -w @pmb/server",
    "dev:web": "npm run dev -w @pmb/web",
    "dev:parser": "bash scripts/dotnet.sh watch --project services/save-parser/PocketMonsterBrawl.SaveParser.csproj run --no-launch-profile",
    "parser:restore": "bash scripts/dotnet.sh restore services/save-parser/PocketMonsterBrawl.SaveParser.csproj",
    "parser:build": "bash scripts/dotnet.sh build services/save-parser/PocketMonsterBrawl.SaveParser.csproj --nologo",
    "build": "npm run build --workspaces --if-present && npm run parser:build",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
